<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.iae.controller.ConfigurationController"
            stylesheets="@../css/app.css"
            prefWidth="980" prefHeight="620">

    <top>
        <HBox styleClass="title-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Configuration Manager" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Manage compile and run profiles for your projects" styleClass="label-hint"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="side-panel" spacing="14" prefWidth="320">
            <padding><Insets top="20" right="16" bottom="20" left="20"/></padding>

            <Label text="Configurations" styleClass="label-section"/>

            <ListView fx:id="configListView" VBox.vgrow="ALWAYS"/>

            <Button fx:id="addButton"
                    text="+ New Configuration"
                    onAction="#onAdd"
                    styleClass="btn-accent"
                    maxWidth="Infinity"/>

            <HBox spacing="8">
                <Button fx:id="editButton"   text="Edit"   onAction="#onEdit"
                        styleClass="btn-primary"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"
                        styleClass="btn-danger"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Separator/>

            <HBox spacing="8">
                <Button fx:id="importButton" text="Import JSON" onAction="#onImport"
                        styleClass="btn-warning"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="exportButton" text="Export JSON" onAction="#onExport"
                        styleClass="btn-warning"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button fx:id="exportAllButton" text="Export All" onAction="#onExportAll"
                    styleClass="btn-warning"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="form-panel" spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="20"/></padding>

            <Label fx:id="formTitleLabel" text="Configuration Details" styleClass="label-title"/>

            <VBox styleClass="form-card" spacing="14" VBox.vgrow="ALWAYS">
                <GridPane hgap="14" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Name"                styleClass="label-form" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField"     promptText="e.g. C, Java 17, Python 3"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Language"            styleClass="label-form" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="languageField" promptText="e.g. C, Java, Python"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Compile Required"    styleClass="label-form" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="compileRequiredCheck" text="Enable compilation step"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Compile Command"     styleClass="label-form" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="compileCommandField" promptText="e.g. gcc"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Compile Args"        styleClass="label-form" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="compileArgsField" promptText="e.g. {sourceFile} -o {outputName}"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Run Command"         styleClass="label-form" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="runCommandField" promptText="e.g. ./{outputName} or python"
                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Run Args"            styleClass="label-form" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="runArgsField"   promptText="e.g. {args}"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Source File Name"    styleClass="label-form" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="sourceFileNameField" promptText="e.g. main.c"
                               GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"
                            styleClass="btn-secondary" prefWidth="110"/>
                    <Button fx:id="saveButton"   text="Save Configuration" onAction="#onSave"
                            styleClass="btn-success" prefWidth="180"
                            defaultButton="true"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
