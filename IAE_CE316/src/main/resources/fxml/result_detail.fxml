<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.iae.controller.ResultDetailController"
            prefWidth="900"
            prefHeight="620"
            stylesheets="@../css/app.css">

    <!-- Top: compact status bar -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 12 15 10 15; -fx-border-color: transparent transparent #cccccc transparent; -fx-border-width: 1;">
            <Label text="Student:" style="-fx-font-weight: bold;"/>
            <Label fx:id="studentIdLabel"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Compile:" style="-fx-font-weight: bold;"/>
            <Label fx:id="compileStatusLabel"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Run:" style="-fx-font-weight: bold;"/>
            <Label fx:id="runStatusLabel"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Output Match:" style="-fx-font-weight: bold;"/>
            <Label fx:id="comparisonStatusLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Close" onAction="#onClose"/>
        </HBox>
    </top>

    <!-- Center: two columns, errors on top row, outputs on bottom row -->
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <!-- Error row -->
            <HBox spacing="10" prefHeight="130">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Compile Error" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="compileErrorArea" editable="false" wrapText="true"
                              VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Run Error" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="runErrorArea" editable="false" wrapText="true"
                              VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
                </VBox>
            </HBox>

            <!-- Output row (grows to fill remaining space) -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="4" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <Label text="Expected Output" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="expectedOutputArea" editable="false" wrapText="true"
                              VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <Label text="Actual Output" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="actualOutputArea" editable="false" wrapText="true"
                              VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
